
#AddHandler application/x-httpd-php54 .php
#AddHandler x-httpd-php54 .php
AddDefaultCharset utf-8

RewriteEngine On
#blokirame tezi koito kradat bandwidht i snimki
RewriteCond %{HTTP_REFERER} ^http://(.+\.)?zoii\.org/ [NC,OR]
RewriteCond %{HTTP_REFERER} ^http://(.+\.)?apkfun\.co/ [NC,OR]
RewriteCond %{HTTP_REFERER} ^http://(.+\.)?buttons-for-your-website\.com/ [NC,OR]
RewriteCond %{HTTP_REFERER} ^http://(.+\.)?blulana\.com/ [NC]
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule .*\.(jpe?g|gif|bmp|png)$ http://www.espravki.com/images/interface/hotlinking.jpe [L]
## STOP REFERRER SPAM
RewriteCond %{HTTP_REFERER} success\-seo\.com [NC,OR]
RewriteCond %{HTTP_REFERER} semalt\.com [NC,OR]
RewriteCond %{HTTP_REFERER} best\-seo\-solution\.com [NC,OR]
RewriteCond %{HTTP_REFERER} best\-seo\-report\.com [NC,OR]
RewriteCond %{HTTP_REFERER} best\-seo\-offer\.com [NC]
RewriteCond %{REQUEST_URI} !^/[0-9]+\..+\.cpaneldcv$
RewriteCond %{REQUEST_URI} !^/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
RewriteRule .* - [F]

#domaina winagi s www
